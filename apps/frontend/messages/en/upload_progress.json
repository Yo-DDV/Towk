{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "upload_progress": {
    "preparing": "Preparing {filename}",
    "uploading": "Uploading {filename}",
    "finalizing": "Validating the upload",
    "sending": "Publishing the message",
    "confirming": "Confirming it in the conversation",
    "confirmed": "Sent",
    "upload_interrupted": "Upload interrupted",
    "message_unconfirmed": "Message not confirmed",
    "file_position": "{filename} · {current}/{total}",
