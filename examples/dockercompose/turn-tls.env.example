# Export these values in the shell that runs ./turn-tls.sh.
# Do not commit a populated copy of this file.
WEB_BIND_IP=203.0.113.10
TURN_BIND_IP=203.0.113.11
TURN_DOMAIN=turn.example.com
TURN_CERT_FILE=/etc/towk/turn/fullchain.pem
TURN_KEY_FILE=/etc/towk/turn/privkey.pem

# Optional. The helper otherwise prefers livekit.generated.yaml when present,
# then falls back to livekit.yaml.
# LIVEKIT_SOURCE_CONFIG=./livekit.generated.yaml

# Optional generated filename below ./.turn-tls/. The helper refuses paths
# outside that private deployment directory. Default: ./.turn-tls/livekit.yaml.
# TURN_LIVEKIT_CONFIG_FILE=./.turn-tls/livekit.custom.yaml

# Optional minimum remaining certificate validity. Default: 14 days.
# TURN_CERT_MIN_VALIDITY_DAYS=14
